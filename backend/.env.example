# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://hospital_user:hospital_password@localhost:5432/hospital_rms?schema=public"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# ---------------------------------------------------------------------------
# Auth — generate strong random secrets for these, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse these example values in a real deployment.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="replace-with-a-long-random-secret-min-32-chars"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie settings
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# Email (optional) — password resets and staff welcome emails
# If left unset, emails are logged to the backend console instead of sent,
# which is convenient for local development but must be configured before
# any real deployment.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Hospital RMS <no-reply@yourhospital.example>"
